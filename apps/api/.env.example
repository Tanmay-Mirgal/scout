# Backend Environment Variables
# Copy this file to .env and fill in the values for your local environment.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (with pgvector)
# Start the database with: docker compose up -d postgres
DATABASE_URL=postgresql://scout:scout@localhost:5432/scout_dev

# Redis
# Start Redis with: docker compose up -d redis
REDIS_URL=redis://localhost:6379
