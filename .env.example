# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development

# ==========================================
# FRONTEND
# ==========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# BACKEND
# ==========================================

API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================

DATABASE_URL=

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# AI - GROQ
# ==========================================

GROQ_API_KEY=
AI_DEFAULT_PROVIDER=GROQ
AI_DEFAULT_MODEL=openai/gpt-oss-20b

# ==========================================
# SEARCH PROVIDERS
# ==========================================

TAVILY_API_KEY=

# ==========================================
# RESEARCH EXECUTION SAFETY LIMITS
# ==========================================

RESEARCH_MAX_TASKS_PER_EXECUTION=5
RESEARCH_MAX_SEARCH_QUERIES_PER_TASK=3
RESEARCH_MAX_RESULTS_PER_QUERY=5
RESEARCH_MAX_SOURCES_PER_TASK=5
RESEARCH_MAX_SOURCE_CONTENT_SIZE=100000
RESEARCH_REQUEST_TIMEOUT_MS=60000
RESEARCH_AI_MAX_RETRIES=3

# ==========================================
# ASYNCHRONOUS QUEUE & SYNTHESIS
# ==========================================
RESEARCH_WORKER_CONCURRENCY=3
RESEARCH_JOB_ATTEMPTS=3
RESEARCH_JOB_BACKOFF_MS=5000
RESEARCH_SYNTHESIS_MIN_COMPLETED_TASKS=1
RESEARCH_SYNTHESIS_MIN_SUPPORTED_CLAIMS=1

# ==========================================
# APPLICATION SECURITY
# ==========================================

JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==========================================
# FUTURE OBSERVABILITY
# ==========================================

LOG_LEVEL=info
